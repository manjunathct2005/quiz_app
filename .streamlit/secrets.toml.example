# For LOCAL testing only (optional): copy this file to
# .streamlit/secrets.toml and fill in real values -- Streamlit will pick
# these up automatically via st.secrets, same as config.py's _get() does.
#
# On Streamlit Community Cloud, you don't need this file at all -- paste
# the same two lines into Manage app -> Settings -> Secrets instead.

HF_API_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SMTP_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
